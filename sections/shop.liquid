{{ 'section-shop.css' | asset_url | stylesheet_tag }}

<section class="sec shop-section" id="shop" data-section-id="{{ section.id }}">
  <div class="wrap">

    <div class="panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>

    {%- assign collection = section.settings.collection -%}
    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="shelf">
        {%- for product in collection.products -%}
          <article class="glass card">
            <div class="shot">
              {%- assign badge_label = product.metafields.custom.badge_label -%}
              {%- if badge_label != blank -%}
                <span class="pill">{{ badge_label }}</span>
              {%- endif -%}

              {%- if product.available == false -%}
                <span class="pill pill-sold-out">Sold out</span>
              {%- endif -%}

              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title, class: 'pimg' }}
              {%- else -%}
                <div class="pimg pimg-placeholder" role="img" aria-label="{{ product.title }}">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                </div>
              {%- endif -%}
            </div>

            <h4>{{ product.title }}</h4>

            {%- assign rating = product.metafields.custom.rating -%}
            {%- assign review_count = product.metafields.custom.review_count -%}
            {%- if rating != blank -%}
              <div class="rate">
                <b>&#9733; {{ rating }}</b>
                {%- if review_count != blank -%}
                  &middot; {{ review_count }} reviews
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="pr">
              <strong>{{ product.price | money }}</strong>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
                {%- assign pct_off = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                <em>{{ pct_off }}% off</em>
              {%- endif -%}
            </div>

            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              {%- if product.available -%}
                <button type="submit" class="btn btn-ghost btn-sm">Add to cart</button>
              {%- else -%}
                <button type="submit" class="btn btn-ghost btn-sm" disabled>Sold out</button>
              {%- endif -%}
            {%- endform -%}
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="shop-empty">Select a collection in the section settings to show products here.</p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Shop",
  "tag": "section",
  "class": "section-shop",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Shop"
    }
  ]
}
{% endschema %}
