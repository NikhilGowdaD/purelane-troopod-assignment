{{ 'section-hero.css' | asset_url | stylesheet_tag }}

<section class="hero" data-section-id="{{ section.id }}">
  <div class="hero-grid page-width">

    {%- comment -%} ---------- BADGES (top strip) ---------- {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="badges glass-2" aria-label="Product promises">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div class="badge" {{ block.shopify_attributes }}>
              <span class="bi">{{ block.settings.icon }}</span>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- COPY ---------- {%- endcomment -%}
    <div class="hero-copy">
      {%- if section.settings.heading != blank -%}
        <h1 class="d1">{{ section.settings.heading }}</h1>
      {%- endif -%}

      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>

      {%- if section.settings.subheading != blank -%}
        <p class="lede">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="hero-cta">
        {%- if section.settings.primary_button_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.primary_button_link | default: '#' }}">
            {{ section.settings.primary_button_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.secondary_button_link | default: '#' }}">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="badgestrip">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <div class="glass-2" {{ block.shopify_attributes }}>
                {{ block.settings.icon }}
                {{ block.settings.label }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- PRODUCT / BUNDLE CAROUSEL ---------- {%- endcomment -%}
    {%- assign slide_blocks = section.blocks | where: 'type', 'bundle_slide' -%}
    {%- if slide_blocks.size > 0 -%}
      <div class="hero-prod" data-hero-carousel>
        <div class="hstage">
          {%- for block in slide_blocks -%}
            {%- assign slide_index = forloop.index -%}
            <div
              class="hslide{% if forloop.first %} on{% endif %}"
              data-n="{{ slide_index }}"
              {{ block.shopify_attributes }}
            >
              {%- comment -%} product images in this slide {%- endcomment -%}
              {%- for i in (1..3) -%}
                {%- assign product_key = 'product_' | append: i -%}
                {%- assign product = block.settings[product_key] -%}
                {%- if product != blank -%}
                  <span class="hp" role="img" aria-label="{{ product.featured_image.alt | default: product.title }}">
                    {%- if product.featured_image != blank -%}
                      {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy' }}
                    {%- endif -%}
                  </span>
                {%- endif -%}
              {%- endfor -%}

              <div class="glass-2 ptag">
                <span class="lbl">{{ block.settings.label }}</span>
                <span class="val">
                  <strong>{{ block.settings.bundle_price | money }}</strong>
                  {%- if block.settings.compare_at_price != blank -%}
                    <s>{{ block.settings.compare_at_price | money }}</s>
                  {%- endif -%}
                </span>
                {%- if block.settings.savings_label != blank -%}
                  <span class="cut">{{ block.settings.savings_label }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if slide_blocks.size > 1 -%}
          <div class="hdots" role="tablist">
            {%- for block in slide_blocks -%}
              <button
                type="button"
                class="{% if forloop.first %}on{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Show slide {{ forloop.index }}"
                data-dot="{{ forloop.index }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'section-hero.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean That Lasts"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon (SVG code)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Plant powered"
        }
      ]
    },
    {
      "type": "bundle_slide",
      "name": "Bundle slide",
      "settings": [
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2 (optional)"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3 (optional)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Slide label",
          "default": "Single bottle"
        },
        {
          "type": "number",
          "id": "bundle_price",
          "label": "Bundle price"
        },
        {
          "type": "number",
          "id": "compare_at_price",
          "label": "Compare-at price"
        },
        {
          "type": "text",
          "id": "savings_label",
          "label": "Savings label",
          "default": "33% off"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "badge", "settings": { "label": "Plant powered" } },
        { "type": "badge", "settings": { "label": "Safe for kids & pets" } },
        { "type": "badge", "settings": { "label": "Zero harsh chemicals" } },
        { "type": "bundle_slide", "settings": { "label": "Single bottle" } }
      ]
    }
  ]
}
{% endschema %}
