{{ 'section-combos.css' | asset_url | stylesheet_tag }}

<section class="sec combos-section" id="combos" data-section-id="{{ section.id }}">
  <div class="wrap">

    <div class="panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      {%- if section.settings.lede != blank -%}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>

    {%- assign combo_blocks = section.blocks | where: 'type', 'combo' -%}
    {%- if combo_blocks.size > 0 -%}
      <div class="comborail" tabindex="0" role="region" aria-label="Combo offers, scroll horizontally">
        {%- for block in combo_blocks -%}
          {%- assign combo = block.settings.combo -%}
          {%- if combo != blank -%}
            <article class="glass combo{% if combo.featured.value %} hero-combo{% endif %}" {{ block.shopify_attributes }}>
              <div class="tray">
                {%- assign savings = combo.compare_at_total.value | minus: combo.combo_price.value -%}
                <span class="save">You save {{ savings | money }}</span>
                {%- if combo.flag_label.value != blank -%}
                  <span class="flag">{{ combo.flag_label.value }}</span>
                {%- endif -%}
                <div class="stack">
                  {%- for product in combo.products.value -%}
                    <span class="it">
                      {%- if product.featured_image != blank -%}
                        {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
                      {%- else -%}
                        <span class="tile" role="img" aria-label="{{ product.title }}">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                        </span>
                      {%- endif -%}
                      <span>{{ product.title }}</span>
                    </span>
                    {%- unless forloop.last -%}<span class="plus" aria-hidden="true">+</span>{%- endunless -%}
                  {%- endfor -%}
                </div>
              </div>

              <div class="body">
                <h3>{{ combo.title.value }}</h3>
                <div class="cnt">{{ combo.products.value.size }} products</div>
                {%- if combo.description.value != blank -%}
                  <p class="inc">{{ combo.description.value }}</p>
                {%- endif -%}
                <div class="prow">
                  <strong>{{ combo.combo_price.value | money }}</strong>
                  <s>{{ combo.compare_at_total.value | money }}</s>
                  <em>Save {{ savings | money }}</em>
                </div>
                <div class="fine">Inclusive of all taxes &middot; COD available</div>
                <a class="btn {% if combo.featured.value %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ section.settings.bundle_link | default: '#bundles' }}">
                  Shop bundle
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
                </a>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        Swipe for more combos
      </div>
    {%- else -%}
      <p class="combos-empty">Add combo blocks in the section settings to show offers here.</p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Combos",
  "tag": "section",
  "class": "section-combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Subtext",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "url",
      "id": "bundle_link",
      "label": "\"Shop bundle\" button link"
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "metaobject",
          "id": "combo",
          "label": "Combo entry",
          "metaobject_type": "combo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combos"
    }
  ]
}
{% endschema %}
